# Meta Model API
MODEL_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
# Reader models
STACKCHECK_READER_MODEL=muse-spark-1.3-contributor
STACKCHECK_PRIVATE_MODEL=muse-spark-1.3
STACKCHECK_SAM_MODEL=sam-3.1
STACKCHECK_SAM_IMAGE_MODE=data_url
STACKCHECK_SAM_PROMPTS=balcony,window
STACKCHECK_REASONING_EFFORT=low
# Reader provider switch
STACKCHECK_EXTRACT_PROVIDER=meta
BASETEN_API_KEY=
BASETEN_BASE_URL=https://inference.baseten.co/v1
BASETEN_MODEL=meta-models/muse-spark-open-1026
FIREWORKS_API_KEY=
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1
FIREWORKS_MODEL=accounts/fireworks/models/muse-spark-open
# App
STACKCHECK_DATA_DIR=data
STACKCHECK_SAMPLES_FILE=data/samples.json
STACKCHECK_WEB_DIST_DIR=web/dist
STACKCHECK_REDACT_NAMES=false
STACKCHECK_BUDGET_USD=150
STACKCHECK_ALERT_USD=100
STACKCHECK_LIVE=false
STACKCHECK_MAX_CONCURRENT_CHECKS=2
STACKCHECK_MAX_QUEUE=10
STACKCHECK_ALLOWED_HOSTS=rera.bihar.gov.in,up-rera.in,www.up-rera.in,rerait.telangana.gov.in,maharera.maharashtra.gov.in,rera.karnataka.gov.in,gujrera.gujarat.gov.in,haryanarera.gov.in
STACKCHECK_STAMP_REQUIRED_STATES=Bihar
STACKCHECK_FETCH_MIN_INTERVAL_S=5.0
STACKCHECK_FETCH_CONNECT_TIMEOUT_S=10.0
STACKCHECK_FETCH_READ_TIMEOUT_S=30.0
STACKCHECK_FETCH_DOC_TIMEOUT_S=90.0
STACKCHECK_CHECK_TIMEOUT_S=1500.0
STACKCHECK_PER_IP_ACTIVE_MAX=3
STACKCHECK_PER_IP_HOURLY_MAX=20
STACKCHECK_FETCH_MAX_BYTES=30000000
